# API NestJS et WebSocket (voir eas.json pour les profils de build).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api/v1
EXPO_PUBLIC_WS_URL=http://10.0.2.2:3001

# Cle TomTom CLIENT (affichage de la carte uniquement). Elle est embarquee dans l'application :
# creer une cle distincte de la cle serveur (TOMTOM_API_KEY de l'API) et la restreindre au produit
# Map Display dans le portail TomTom. Vide => fond de carte OpenFreeMap de repli.
EXPO_PUBLIC_TOMTOM_API_KEY=


# Modele 3D du vehicule pour la vue 3D (glTF/GLB en https, compression Draco acceptee).
# Vide : camion genere par three.js.
EXPO_PUBLIC_VEHICLE_MODEL_URL=
