# URL publique de l'API NestJS, utilisée par le navigateur (fetch côté client).
# 127.0.0.1 plutôt que localhost : le relais IPv6 ::1 de Docker Desktop (wslrelay)
# est instable sur certains postes Windows et fige les connexions.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1

# URL publique du serveur WebSocket (Socket.IO) de l'API, pour le suivi temps réel.
NEXT_PUBLIC_API_WS_URL=http://127.0.0.1:3001

# Style MapLibre (URL vers un style.json). En dev, la démo publique MapLibre convient.
# En production, utiliser un style MapTiler/OSM avec une clé (voir README).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Tuiles d'elevation utilisees pour le relief 3D (encodage terrarium).
NEXT_PUBLIC_MAP_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# URL interne de l'API, utilisée uniquement côté serveur par les Route Handlers Next.js
# (proxy d'authentification). Peut différer de NEXT_PUBLIC_API_BASE_URL en prod (réseau interne).
API_BASE_URL=http://127.0.0.1:3001/api/v1

# Cle TomTom CLIENT (affichage de la carte). Elle finit dans le bundle navigateur : creer une cle distincte
# de celle du serveur (TOMTOM_API_KEY) et la restreindre (referers/domaines, produits Map Display uniquement)
# dans le portail TomTom. Vide => repli sur NEXT_PUBLIC_MAP_STYLE_URL (OpenFreeMap).
NEXT_PUBLIC_TOMTOM_API_KEY=
# Version de ressource du style TomTom (voir la doc "Map Styles").
NEXT_PUBLIC_TOMTOM_STYLE_VERSION=24.*
