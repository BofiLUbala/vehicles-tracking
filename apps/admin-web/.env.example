# URL publique de l'API NestJS, utilisée par le navigateur (fetch côté client).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# URL publique du serveur WebSocket (Socket.IO) de l'API, pour le suivi temps réel.
NEXT_PUBLIC_API_WS_URL=http://localhost:3001

# Style MapLibre (URL vers un style.json). En dev, la démo publique MapLibre convient.
# En production, utiliser un style MapTiler/OSM avec une clé (voir README).
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# URL interne de l'API, utilisée uniquement côté serveur par les Route Handlers Next.js
# (proxy d'authentification). Peut différer de NEXT_PUBLIC_API_BASE_URL en prod (réseau interne).
API_BASE_URL=http://localhost:3001/api/v1
