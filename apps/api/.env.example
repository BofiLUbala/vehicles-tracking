PORT=3001
DATABASE_URL=
REDIS_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
QR_TOKEN_SECRET=
# stub (defaut) : journalise les codes OTP au lieu d'appeler des API externes. live : appels reels.
# OTP_CHANNEL_MODE est l'interrupteur global (retrocompatible) ; OTP_WHATSAPP_MODE / OTP_EMAIL_MODE
# permettent d'activer un canal en live independamment de l'autre (ex: SMTP configure mais pas WhatsApp).
OTP_CHANNEL_MODE=stub
OTP_WHATSAPP_MODE=
OTP_EMAIL_MODE=
# Identifiants du super-admin de demonstration crees par prisma/seed.ts (jamais un vrai secret).
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=ChangeMe123
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tracking-vehicles
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
# true en local avec MinIO (chemin /bucket/key), false sur un vrai S3 AWS (sous-domaine).
S3_FORCE_PATH_STYLE=true
# Durée de validité (secondes) des URLs signées de téléchargement de fichiers (photos).
FILE_SIGNED_URL_TTL_SECONDS=600
# Seuil de précision GPS (mètres) au-delà duquel une validation d'étape est rejetée (LOW_GPS_ACCURACY).
MAX_GPS_ACCURACY_METERS=100
# Vitesse implicite max (km/h) entre deux positions GPS successives d'un véhicule au-delà de laquelle
# une Alert IMPOSSIBLE_SPEED (MEDIUM) est créée — la position est stockée quand même.
MAX_PLAUSIBLE_SPEED_KMH=150
# Minutes sans nouvelle position GPS au-delà desquelles un véhicule est considéré OFFLINE (calculé à la volée
# par GET /tracking/vehicles/live, ET utilisé par le balayage cron VehicleOfflineCron qui émet vehicle.offline).
VEHICLE_OFFLINE_THRESHOLD_MINUTES=5
# Consommation (L/100km) au-delà de laquelle une déclaration de carburant est jugée implausible (Alert FUEL_ANOMALY).
MAX_PLAUSIBLE_FUEL_CONSUMPTION_L_PER_100KM=40
# Nombre d'heures minimum entre deux déclarations de carburant pour le même véhicule avant Alert FUEL_ANOMALY.
MIN_HOURS_BETWEEN_FUEL_RECORDS=2
FIREBASE_PROJECT_ID=
CORS_ALLOWED_ORIGINS=
