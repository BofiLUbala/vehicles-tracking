# --- Base de données ---
# Valeurs ci-dessous pour le service `api` DANS docker-compose (réseau interne : postgres:5432, redis:6379).
# En dev local (hors Docker, ex: apps/api/.env pour `npm test`/`prisma migrate`), utiliser les ports
# publiés par docker-compose.yml (5434/6380 par défaut) — voir docs/PHASE1_NOTES.md.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tracking_vehicles
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- WhatsApp Business Cloud API (OTP chauffeurs) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# --- E-mail (OTP admin) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Delais SMTP (ms). La connexion est pre-chauffee au demarrage de l'API et mise en pool ; ces
# valeurs ne bornent que l'attente cote requete HTTP.
SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_SOCKET_TIMEOUT_MS=45000
SMTP_SEND_TIMEOUT_MS=30000
# true si le reseau resout le SMTP en IPv6 sans route utilisable.
SMTP_IPV4_ONLY=false

# --- Canaux OTP ---
# stub (defaut) : le code est seulement journalise. live : envoi reel.
# OTP_CHANNEL_MODE est l'interrupteur global ; OTP_WHATSAPP_MODE / OTP_EMAIL_MODE activent un
# canal independamment de l'autre. Sans OTP_EMAIL_MODE=live, aucun e-mail d'OTP admin n'est envoye.
OTP_CHANNEL_MODE=stub
OTP_WHATSAPP_MODE=
OTP_EMAIL_MODE=live
# Repli de developpement si le SMTP est injoignable : le code est journalise au lieu de faire
# echouer l'inscription/connexion. Sans effet dans l'image Docker (NODE_ENV=production).
OTP_EMAIL_FALLBACK_LOG=false
# Developpement uniquement : renvoie le code OTP dans la reponse HTTP. Sans effet en production.
OTP_DEV_EXPOSE_CODE=false

# --- Signature des QR codes chauffeurs ---
QR_TOKEN_SECRET=

# --- Stockage S3 compatible (photos) — voir service `minio` dans docker-compose.yml ---
S3_ENDPOINT=http://minio:9000
S3_BUCKET=tracking-vehicles
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
FILE_SIGNED_URL_TTL_SECONDS=600

# --- Validation GPS des étapes de mission ---
MAX_GPS_ACCURACY_METERS=100

# --- Suivi GPS temps réel (tracking) ---
# Vitesse implicite max (km/h) entre deux positions successives au-delà de laquelle une Alert
# IMPOSSIBLE_SPEED (MEDIUM) est créée (la position est stockée quand même).
MAX_PLAUSIBLE_SPEED_KMH=150
# Minutes sans nouvelle position au-delà desquelles un véhicule est considéré OFFLINE.
VEHICLE_OFFLINE_THRESHOLD_MINUTES=5

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- admin-web (Next.js) ---
# NEXT_PUBLIC_* sont injectées au build ET au runtime du conteneur admin-web (voir Dockerfile) ;
# elles finissent dans le bundle JS envoyé au navigateur, donc jamais de secret ici.
# URL publique de l'API, utilisée par le navigateur (fetch côté client).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# URL publique du serveur WebSocket (Socket.IO) de l'API pour le suivi temps réel.
NEXT_PUBLIC_API_WS_URL=http://localhost:3001
# Style MapLibre (URL vers un style.json). OpenFreeMap est libre et sans cle d'API ; il fournit les
# villes, les routes et la couche `building-3d` utilisee par la vue 3D.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Tuiles d'elevation pour le relief 3D (encodage terrarium, jeu public AWS sans cle).
NEXT_PUBLIC_MAP_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# URL interne de l'API utilisée uniquement côté serveur par les Route Handlers Next.js (proxy
# d'authentification). Dans docker-compose, c'est le nom de service interne (réseau Docker) :
API_BASE_URL=http://api:3001/api/v1
