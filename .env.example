# --- Base de données ---
# Valeurs ci-dessous pour le service `api` DANS docker-compose (réseau interne : postgres:5432, redis:6379).
# En dev local (hors Docker, ex: apps/api/.env pour `npm test`/`prisma migrate`), utiliser les ports
# publiés par docker-compose.yml (5434/6380 par défaut) — voir docs/PHASE1_NOTES.md.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tracking_vehicles
REDIS_URL=redis://redis:6379

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- WhatsApp Business Cloud API (OTP chauffeurs) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

# --- E-mail (OTP admin) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Stockage S3 compatible (photos) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Firebase Cloud Messaging ---
FIREBASE_PROJECT_ID=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
